msgid "more"
msgstr "lagi"

msgid "Press Shift + N to view notifications"
msgstr "Tekan Shift + N untuk melihat notifikasi"

msgid "Sleep prevented by an active process"
msgstr "Mode tidur dicegah oleh proses aktif"

msgid "Home"
msgstr "Beranda"

msgid "Resources"
msgstr "Sumber Daya"

msgid "Extension Repo"
msgstr "Repositori Ekstensi"

msgid "Open on GitHub"
msgstr "Buka di GitHub"

msgid "Enjoying this extension?"
msgstr "Menikmati ekstensi ini?"

msgid "Consider supporting its development!"
msgstr "Pertimbangkan untuk mendukung pengembangannya!"

msgid "Ko-fi"
msgstr "Ko-fi"

msgid "Open Ko-fi"
msgstr "Buka Ko-fi"

msgid "Saweria"
msgstr "Saweria"

msgid "Open Saweria"
msgstr "Buka Saweria"

msgid "Upgrade to [PRO]"
msgstr "Tingkatkan ke [PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "Lihat fitur PRO ekstensi ini di repositori GitHub."

msgid "Visit documentation on GitHub"
msgstr "Kunjungi dokumentasi di GitHub"

msgid "Configuration"
msgstr "Konfigurasi"

msgid "General"
msgstr "Umum"

msgid "Password Field Indicators"
msgstr "Indikator Kolom Kata Sandi"

msgid "Show Caps Lock and keyboard layout icons inside the password field."
msgstr "Tampilkan ikon Caps Lock dan tata letak keyboard di dalam kolom kata sandi."

msgid "Cursor Blinking"
msgstr "Kedipan Kursor"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Aktifkan atau nonaktifkan kedipan kursor teks di kolom kata sandi."

msgid "Custom Lockscreen Wallpaper"
msgstr "Gambar Latar Layar Kunci Kustom"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Gunakan gambar kustom sebagai latar belakang layar kunci."

msgid "Wallpaper Image Path"
msgstr "Jalur Gambar Latar"

msgid "No image selected"
msgstr "Tidak ada gambar yang dipilih"

msgid "Select Lockscreen Wallpaper"
msgstr "Pilih Gambar Latar Layar Kunci"

msgid "Images and Slideshows"
msgstr "Gambar dan Tayangan Slide"

msgid "Select Image File"
msgstr "Pilih Berkas Gambar"

msgid "Select"
msgstr "Pilih"

msgid "Cancel"
msgstr "Batal"

msgid "Per-Monitor Wallpapers"
msgstr "Gambar Latar Per Monitor"

msgid "Monitors without their own wallpaper use the one above."
msgstr "Monitor tanpa gambar latar khusus akan menggunakan gambar di atas."

msgid "Default"
msgstr "Bawaan"

msgid "Use the Default Wallpaper"
msgstr "Gunakan Gambar Latar Bawaan"

msgid "Clock and Date"
msgstr "Jam dan Tanggal"

msgid "Clock Weight"
msgstr "Ketebalan Font Jam"

msgid "Font weight of the lockscreen time."
msgstr "Ketebalan font waktu di layar kunci."

msgid "Restore defaults"
msgstr "Kembalikan ke Default"

msgid "Light"
msgstr "Tipis"

msgid "Regular"
msgstr "Reguler"

msgid "Medium"
msgstr "Sedang"

msgid "Semibold"
msgstr "Semi Tebal"

msgid "Bold"
msgstr "Tebal"

msgid "Heavy"
msgstr "Sangat Tebal"

msgid "Clock Format"
msgstr "Format Jam"

msgid "Override the system 12/24-hour setting on the lockscreen."
msgstr "Ganti pengaturan sistem 12/24 jam pada layar kunci."

msgid "System"
msgstr "Sistem"

msgid "12-hour"
msgstr "12 jam"

msgid "24-hour"
msgstr "24 jam"

msgid "Date Style"
msgstr "Format Tanggal"

msgid "Choose between shortened and full date names."
msgstr "Pilih antara nama tanggal yang disingkat atau lengkap."

msgid "Short"
msgstr "Pendek"

msgid "Full"
msgstr "Lengkap"

msgid "Wallpaper-Tinted Clock"
msgstr "Jam Beraksen Warna Gambar Latar"

msgid "Tint the clock and date with a light shade of the wallpaper colour."
msgstr "Beri nuansa warna jam dan tanggal dengan aksen lembut dari gambar latar."

msgid "Lockscreen Mode"
msgstr "Mode Layar Kunci"

msgid "Mode"
msgstr "Mode"

msgid "Legacy"
msgstr "Klasik"

msgid "Cupertino"
msgstr "Cupertino"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Tata letak layar kunci lengkap yang terinspirasi macOS Sonoma (klik ikon pengguna untuk beralih pengguna)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "Jam bergaya macOS Sonoma di atas tata letak klasik standar GNOME."

msgid "Sonoma Status Corner"
msgstr "Sudut Status Sonoma"

msgid "Restyle the top-right battery, network and input source icons."
msgstr "Mengubah gaya ikon baterai, jaringan, dan sumber masukan di sudut kanan atas."

msgid "Always Show User Widget"
msgstr "Selalu Tampilkan Widget Pengguna"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Sembunyikan notifikasi secara default. Tekan Shift+N untuk menampilkan notifikasi."

msgid "Prompt Vibrancy"
msgstr "Efek Kedalaman Kolom Kata Sandi"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Peningkatan warna dan kedalaman adaptif untuk kolom kata sandi."

msgid "Lightweight, color-based mode."
msgstr "Mode ringan berbasis warna."

msgid "Advanced, blur-based mode."
msgstr "Mode canggih berbasis efek buram."

msgid "Tonal"
msgstr "Tonal"

msgid "Acrylic"
msgstr "Akrilik"

msgid "Show message when locked"
msgstr "Tampilkan pesan saat terkunci"

msgid "Set..."
msgstr "Atur..."

msgid "Set a message to appear on the lockscreen"
msgstr "Atur pesan yang akan ditampilkan di layar kunci"

msgid "OK"
msgstr "OK"

msgid "Unlock Crossfade"
msgstr "Transisi Mulus Saat Membuka Kunci"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Transisi halus dari layar kunci ke desktop saat membuka kunci (otomatis dinonaktifkan dalam mode Hemat Daya)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Memerlukan WACK Shell untuk dipasang dan diaktifkan."

msgid "Requires WACK Shell to be enabled."
msgstr "Memerlukan WACK Shell untuk diaktifkan."

msgid "Crossfade Speed"
msgstr "Kecepatan Transisi"

msgid "Slower"
msgstr "Lebih Lambat"

msgid "Faster"
msgstr "Lebih Cepat"

msgid "Clock Animation"
msgstr "Animasi Jam"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Diterapkan pada tanggal dan waktu saat membuka kolom kata sandi"

msgid "Scale Down"
msgstr "Perkecil"

msgid "Zoom Up"
msgstr "Perbesar ke Atas"

msgid "Slide Up"
msgstr "Geser ke Atas"

msgid "Fade"
msgstr "Pudar"

msgid "Prompt Animation"
msgstr "Animasi Kolom Input"

msgid "Applied to the authentication prompt while it appears"
msgstr "Diterapkan pada kolom autentikasi saat muncul"

msgid "GNOME Default"
msgstr "Bawaan GNOME"

msgid "Rise"
msgstr "Terangkat"

msgid "Zoom"
msgstr "Perbesar"

msgid "Reset Animations"
msgstr "Reset Animasi"

msgid "Reset animations"
msgstr "Reset animasi"

msgid "Display and Power"
msgstr "Layar dan Daya"

msgid "Keep Screen On"
msgstr "Biarkan Layar Tetap Menyala"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Mencegah layar langsung mati saat terkunci. Layar tetap akan mati setelah batas waktu normal di pengaturan sistem."

msgid "Only on AC Power"
msgstr "Hanya Saat Menggunakan Daya AC"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Hanya biarkan layar menyala jika perangkat terhubung ke sumber daya listrik"

msgid "Escape to Sleep / Suspend"
msgstr "Tekan Escape untuk Tidur / Suspend"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Tekan Escape pada layar kunci untuk mematikan layar (atau menidurkan sistem)"

msgid "Extras"
msgstr "Ekstra"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] Ekspansi GDM"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Status: Aktif. Tata letak kustom aktif di GDM."

msgid "Status: Disabled."
msgstr "Status: Nonaktif."

msgid "Enabled"
msgstr "Aktif"

msgid "Disabled"
msgstr "Nonaktif"

msgid "Cupertino System Actions"
msgstr "Tindakan Sistem Cupertino"

msgid "Show Suspend, Restart and Power Off under the login user list, replacing the Quick Settings power menu."
msgstr "Tampilkan Tidurkan, Mulai Ulang, dan Matikan di bawah daftar pengguna, menggantikan menu daya Pengaturan Cepat."

msgid "GDM Expansion Documentation"
msgstr "Dokumentasi Ekspansi GDM"

msgid "Revert GDM login screen layout to GNOME Default. See repository instructions."
msgstr "Kembalikan tata letak layar masuk GDM ke default GNOME. Lihat petunjuk di repositori."

msgid "Open repository documentation"
msgstr "Buka Dokumentasi Repositori"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "Ekstensi tidak terpasang secara sistem di /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "Modul ekspansi GDM (src/pro) tidak ditemukan di sistem."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "Mode sesi GDM belum diaktifkan di metadata sistem."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "Konfigurasi dconf untuk GDM (/etc/dconf/db/gdm.d) tidak ditemukan."

msgid "GDM integration is not configured."
msgstr "Integrasi GDM belum dikonfigurasi."

msgid "GDM DLC Documentation"
msgstr "Dokumentasi DLC GDM"

msgid "Visit the repository to view setup and installation documentation."
msgstr "Kunjungi repositori untuk melihat panduan penyiapan dan pemasangan."

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] Integrasi WACK Shell"

msgid "Installed"
msgstr "Terpasang"

msgid "Not Installed"
msgstr "Belum Terpasang"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Terpasang. Mengaktifkan transisi halus dan kustomisasi shell bergaya Cupertino."

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Belum terpasang. Pasang WACK Shell untuk membuka efek transisi."

msgid "WACK Shell Repository"
msgstr "Repositori WACK Shell"

msgid "Open the WACK Shell repository for documentation and updates."
msgstr "Buka repositori WACK Shell untuk dokumentasi dan pembaruan."

msgid "Open WACK Shell repository"
msgstr "Buka Repositori WACK Shell"

msgid "Visit the repository to view installation instructions and release packages."
msgstr "Kunjungi repositori untuk melihat petunjuk pemasangan dan paket rilis."

msgid "Clear Visual Cache"
msgstr "Bersihkan Cache Visual"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Menghapus data visual sementara untuk gambar latar dan efek kedalaman. Data akan dibuat ulang secara otomatis."

msgid "Clear"
msgstr "Bersihkan"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Membersihkan cache visual yang digunakan untuk gambar latar dan efek"

msgid "Visual cache cleared successfully!"
msgstr "Cache visual berhasil dibersihkan!"

msgid "Failed to clear cache:"
msgstr "Gagal membersihkan cache:"

