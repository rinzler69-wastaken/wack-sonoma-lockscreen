msgstr "Generelt"

msgid "Password Field Indicators"
msgstr "Indikatorer i adgangskodefeltet"

msgid "Show Caps Lock and keyboard layout icons inside the password field."
msgstr "Vis Caps Lock- og tastaturlayoutikoner i adgangskodefeltet."

msgid "Cursor Blinking"
msgstr "Blinkende markør"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Aktivér eller deaktivér blinkende tekstmarkør i adgangskodefeltet."

msgid "Custom Lockscreen Wallpaper"
msgstr "Brugertilpasset låseskærmsbaggrund"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Brug et tilpasset billede som baggrund på låseskærmen."

msgid "Wallpaper Image Path"
msgstr "Sti til baggrundsbillede"

msgid "No image selected"
msgstr "Intet billede valgt"

msgid "Select Lockscreen Wallpaper"
msgstr "Vælg låseskærmsbaggrund"

