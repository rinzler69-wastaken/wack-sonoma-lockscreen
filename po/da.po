msgstr "Vælg billedfil"

msgid "Select"
msgstr "Vælg"

msgid "Cancel"
msgstr "Annuller"

msgid "Per-Monitor Wallpapers"
msgstr "Baggrunde pr. skærm"

msgid "Monitors without their own wallpaper use the one above."
msgstr "Skærme uden deres eget baggrundsbillede bruger billedet ovenfor."

msgid "Default"
msgstr "Standard"

msgid "Use the Default Wallpaper"
msgstr "Brug standardbaggrundsbilledet"

msgid "Clock and Date"
msgstr "Ur og dato"

msgid "Clock Weight"
msgstr "Urets skrifttykkelse"

msgid "Font weight of the lockscreen time."
msgstr "Skrifttykkelse for klokkeslættet på låseskærmen."

msgid "Restore defaults"
msgstr "Gendan standarder"

msgid "Light"
msgstr "Let"

msgid "Regular"
msgstr "Normal"

msgid "Medium"
msgstr "Mellem"

msgid "Semibold"
msgstr "Halvfed"

msgid "Bold"
msgstr "Fed"

msgid "Heavy"
msgstr "Ekstra fed"

msgid "Clock Format"
msgstr "Urformat"

msgid "Override the system 12/24-hour setting on the lockscreen."
msgstr "Tilsidesæt systemets 12/24-timers indstilling på låseskærmen."

msgid "System"
msgstr "System"

msgid "12-hour"
msgstr "12-timers"

msgid "24-hour"
msgstr "24-timers"

msgid "Date Style"
msgstr "Datostil"

msgid "Choose between shortened and full date names."
msgstr "Vælg mellem forkortede og fulde datonavne."

msgid "Short"
msgstr "Kort"

msgid "Full"
msgstr "Fuld"

msgid "Wallpaper-Tinted Clock"
msgstr "Baggrundstonet ur"

msgid "Tint the clock and date with a light shade of the wallpaper colour."
msgstr "Ton uret og datoen med en lys nuance af baggrundsfarven."

msgid "Lockscreen Mode"
msgstr "Låseskærmstilstand"

msgid "Mode"
msgstr "Tilstand"

msgid "Legacy"
msgstr "Klassisk"

msgid "Cupertino"
msgstr "Cupertino"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Et komplet macOS Sonoma-inspireret låseskærmslayout (klik på brugerikonet for at skifte bruger)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "Ur i macOS Sonoma-stil over det klassiske, GNOME-kompatible layout."

msgid "Sonoma Status Corner"
msgstr "Sonoma-statushjørne"

msgid "Restyle the top-right battery, network and input source icons."
msgstr "Tilpas stilen på batteri-, netværks- og inputkildeikoner i øverste højre hjørne."

msgid "Always Show User Widget"
msgstr "Vis altid brugerwidget"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Skjuler notifikationer som standard. Tryk på Shift+N for at vise notifikationer."

msgid "Prompt Vibrancy"
msgstr "Feltets livlighed"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Tilpassede farve- og dybdeforbedringer til adgangskodefeltet."

msgid "Lightweight, color-based mode."
msgstr "Let, farvebaseret tilstand."

msgid "Advanced, blur-based mode."
msgstr "Avanceret tilstand baseret på sløring."

msgid "Tonal"
msgstr "Tonal"

msgid "Acrylic"
msgstr "Akryl"

msgid "Show message when locked"
msgstr "Vis besked, når skærmen er låst"

msgid "Set..."
msgstr "Indstil..."

msgid "Set a message to appear on the lockscreen"
msgstr "Indstil en besked, der skal vises på låseskærmen"

msgid "OK"
msgstr "OK"

msgid "Unlock Crossfade"
msgstr "Overgang ved oplåsning"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Glidende overgang mellem låseskærm og skrivebord ved oplåsning (deaktiveres automatisk i strømsparetilstand)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Kræver, at WACK Shell er installeret og aktiveret."

msgid "Requires WACK Shell to be enabled."
msgstr "Kræver, at WACK Shell er aktiveret."

msgid "Crossfade Speed"
msgstr "Overgangshastighed"

msgid "Slower"
msgstr "Langsommere"

msgid "Faster"
msgstr "Hurtigere"

msgid "Clock Animation"
msgstr "Uranimation"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Anvendes på dato og klokkeslæt, når adgangskodeprompten åbnes"

msgid "Scale Down"
msgstr "Formindsk"

msgid "Zoom Up"
msgstr "Zoom op"

msgid "Slide Up"
msgstr "Glid op"

msgid "Fade"
msgstr "Fade"

msgid "Prompt Animation"
msgstr "Promptanimation"

msgid "Applied to the authentication prompt while it appears"
msgstr "Anvendes på godkendelsesprompten, når den vises"

msgid "GNOME Default"
msgstr "GNOME-standard"

msgid "Rise"
msgstr "Stigning"

msgid "Zoom"
msgstr "Zoom"

msgid "Reset Animations"
msgstr "Nulstil animationer"

msgid "Reset animations"
msgstr "Nulstil animationer"

msgid "Display and Power"
msgstr "Skærm og strøm"

msgid "Keep Screen On"
msgstr "Hold skærmen tændt"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Forhindrer, at skærmen slukker med det samme, når den er låst. Skærmen slukker stadig efter systemets tidsgrænse."

msgid "Only on AC Power"
msgstr "Kun ved strømforsyning"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Hold kun skærmen tændt, hvis computeren er tilsluttet strøm"

msgid "Escape to Sleep / Suspend"
msgstr "Escape for at gå i dvale"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Tryk på Escape på låseskærmen for at slukke skærmen (eller gå i dvale)"

msgid "Extras"
msgstr "Ekstra"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM-udvidelse"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Status: Aktiveret. Det tilpassede layout er aktivt på GDM."

msgid "Status: Disabled."
msgstr "Status: Deaktiveret."

msgid "Enabled"
msgstr "Aktiveret"

msgid "Disabled"
msgstr "Deaktiveret"

msgid "Cupertino System Actions"
msgstr "Cupertino-systemhandlinger"

msgid "Show Suspend, Restart and Power Off under the login user list, replacing the Quick Settings power menu."
msgstr "Vis Dvale, Genstart og Sluk under brugerlisten, hvilket erstatter strømmenuen i Hurtige indstillinger."

msgid "Dim Background Wallpaper"
msgstr "Dæmp baggrundsbillede"

msgid "Apply a subtle 15% darkening overlay to the login wallpaper for enhanced contrast."
msgstr "Anvend et diskret 15 % mørkt overlag på logindbaggrunden for bedre kontrast."

msgid "GDM Expansion Documentation"
msgstr "Dokumentation for GDM-udvidelse"

msgid "Revert GDM login screen layout to GNOME Default. See repository instructions."
msgstr "Nulstil GDM-loginskærmen til GNOME-standarden. Se instruktionerne i lageret."

msgid "Open repository documentation"
msgstr "Åbn lagerets dokumentation"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "Udvidelsen er ikke installeret systemomfattende i /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "GDM-udvidelsesmoduler (src/pro) mangler på systemet."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "GDM-sessionstilstand er ikke aktiveret i systemmetadata."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "GDM dconf-tilsidesættelseskonfiguration (/etc/dconf/db/gdm.d) mangler."

msgid "GDM integration is not configured."
msgstr "GDM-integration er ikke konfigureret."

msgid "GDM DLC Documentation"
msgstr "Dokumentation for GDM-DLC"

msgid "Visit the repository to view setup and installation documentation."
msgstr "Besøg lageret for at se opsætnings- og installationsdokumentation."

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] WACK Shell-integration"

msgid "Installed"
msgstr "Installeret"

msgid "Not Installed"
msgstr "Ikke installeret"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Installeret. Aktiverer overgange og Cupertino-inspirerede skaltilpasninger."

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Ikke installeret. Installer WACK Shell for at låse op for overgangseffekter."

msgid "WACK Shell Repository"
msgstr "WACK Shell-lager"

msgid "Open the WACK Shell repository for documentation and updates."
msgstr "Åbn WACK Shell-lageret for dokumentation og opdateringer."

msgid "Open WACK Shell repository"
msgstr "Åbn WACK Shell-lageret"

msgid "Visit the repository to view installation instructions and release packages."
msgstr "Besøg lageret for installationsinstruktioner og udgivelsespakker."

msgid "Clear Visual Cache"
msgstr "Ryd visuel cache"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Rydder midlertidige visuelle data, der bruges til baggrunde og effekter. De gendannes automatisk."

msgid "Clear"
msgstr "Ryd"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Rydder den visuelle cache, der bruges til baggrundsbilleder og effekter"

msgid "Visual cache cleared successfully!"
msgstr "Visuel cache blev ryddet!"

msgid "Failed to clear cache:"
msgstr "Kunne ikke rydde cache:"

