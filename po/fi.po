msgstr "Ohita järjestelmän 12/24 tunnin asetus lukitusnäytöllä."

msgid "System"
msgstr "Järjestelmä"

msgid "12-hour"
msgstr "12-tuntinen"

msgid "24-hour"
msgstr "24-tuntinen"

msgid "Date Style"
msgstr "Päiväyksen tyyli"

