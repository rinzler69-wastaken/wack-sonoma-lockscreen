msgstr "Generelt"

msgid "Password Field Indicators"
msgstr "Indikatorer i passordfeltet"

msgid "Show Caps Lock and keyboard layout icons inside the password field."
msgstr "Vis Caps Lock- og tastaturoppsettikoner i passordfeltet."

msgid "Cursor Blinking"
msgstr "Blinkende skrivemerke"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Aktiver eller deaktiver blinkende skrivemerke i passordfeltet."

msgid "Custom Lockscreen Wallpaper"
msgstr "Egendefinert bakgrunn for låseskjerm"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Bruk et egendefinert bilde som bakgrunn på låseskjermen."

msgid "Wallpaper Image Path"
msgstr "Bane til bakgrunnsbilde"

msgid "No image selected"
msgstr "Ingen bilder valgt"

msgid "Select Lockscreen Wallpaper"
msgstr "Velg bakgrunn for låseskjerm"

