msgstr "Открыть Saweria"

msgid "Upgrade to [PRO]"
msgstr "Обновить до [PRO]"

msgid "Check PRO features of this extension on this extension's GitHub repo."
msgstr "Узнайте о возможностях версии PRO в репозитории на GitHub."

msgid "Visit documentation on GitHub"
msgstr "Перейти к документации на GitHub"

msgid "Configuration"
msgstr "Настройка"

msgid "General"
msgstr "Общие"

msgid "Password Field Indicators"
msgstr "Индикаторы в поле ввода пароля"

msgid "Show Caps Lock and keyboard layout icons inside the password field."
msgstr "Отображать значки Caps Lock и раскладки клавиатуры внутри поля ввода пароля."

msgid "Cursor Blinking"
msgstr "Мигание курсора"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Включить или отключить мигание текстового курсора в поле ввода пароля."

msgid "Custom Lockscreen Wallpaper"
msgstr "Собственные обои экрана блокировки"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Использовать собственное изображение в качестве фона экрана блокировки."

msgid "Wallpaper Image Path"
msgstr "Путь к изображению обоев"

msgid "No image selected"
msgstr "Изображение не выбрано"

msgid "Select Lockscreen Wallpaper"
msgstr "Выберите обои экрана блокировки"

msgid "Images and Slideshows"
msgstr "Изображения и слайд-шоу"

msgid "Select Image File"
msgstr "Выбрать файл изображения"

msgid "Select"
msgstr "Выбрать"

msgid "Cancel"
msgstr "Отмена"

msgid "Per-Monitor Wallpapers"
msgstr "Обои для каждого монитора"

msgid "Monitors without their own wallpaper use the one above."
msgstr "Мониторы без собственных обоев используют изображение выше."

msgid "Default"
msgstr "По умолчанию"

msgid "Use the Default Wallpaper"
msgstr "Использовать обои по умолчанию"

msgid "Clock and Date"
msgstr "Часы и дата"

msgid "Clock Weight"
msgstr "Толщина шрифта часов"

msgid "Font weight of the lockscreen time."
msgstr "Толщина шрифта времени на экране блокировки."

msgid "Restore defaults"
msgstr "Сбросить по умолчанию"

msgid "Light"
msgstr "Тонкий"

msgid "Regular"
msgstr "Обычный"

msgid "Medium"
msgstr "Средний"

msgid "Semibold"
msgstr "Полужирный"

msgid "Bold"
msgstr "Жирный"

msgid "Heavy"
msgstr "Тяжёлый"

msgid "Clock Format"
msgstr "Формат часов"

msgid "Override the system 12/24-hour setting on the lockscreen."
msgstr "Переопределить системный 12/24-часовой формат на экране блокировки."

msgid "System"
msgstr "Системный"

msgid "12-hour"
msgstr "12-часовой"

msgid "24-hour"
msgstr "24-часовой"

msgid "Date Style"
msgstr "Формат даты"

msgid "Choose between shortened and full date names."
msgstr "Выберите между сокращённым и полным отображением даты."

msgid "Short"
msgstr "Краткий"

msgid "Full"
msgstr "Полный"

msgid "Wallpaper-Tinted Clock"
msgstr "Оттенок часов под обои"

msgid "Tint the clock and date with a light shade of the wallpaper colour."
msgstr "Окрашивать часы и дату в мягкий оттенок преобладающего цвета обоев."

msgid "Lockscreen Mode"
msgstr "Режим экрана блокировки"

msgid "Mode"
msgstr "Режим"

msgid "Legacy"
msgstr "Классический"

msgid "Cupertino"
msgstr "Cupertino"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Полноценный интерфейс в стиле macOS Sonoma (нажмите значок пользователя для смены учётной записи)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "Часы в стиле macOS Sonoma поверх классического интерфейса GNOME."

msgid "Sonoma Status Corner"
msgstr "Значки статуса Sonoma"

msgid "Restyle the top-right battery, network and input source icons."
msgstr "Изменяет стиль значков батареи, сети и раскладки в правом верхнем углу."

msgid "Always Show User Widget"
msgstr "Всегда показывать виджет пользователя"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Скрывает уведомления по умолчанию. Нажмите Shift+N для их отображения."

msgid "Prompt Vibrancy"
msgstr "Эффект глубины поля пароля"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Адаптивные цвета и эффект размытия для поля ввода пароля."

msgid "Lightweight, color-based mode."
msgstr "Легковесный режим на основе цвета."

msgid "Advanced, blur-based mode."
msgstr "Продвинутый режим с эффектом размытия."

msgid "Tonal"
msgstr "Тональный"

msgid "Acrylic"
msgstr "Акриловый"

msgid "Show message when locked"
msgstr "Показывать сообщение на экране блокировки"

msgid "Set..."
msgstr "Задать..."

msgid "Set a message to appear on the lockscreen"
msgstr "Введите сообщение для экрана блокировки"

msgid "OK"
msgstr "OK"

msgid "Unlock Crossfade"
msgstr "Плавный переход при разблокировке"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Плавный переход от экрана блокировки к рабочему столу (отключается в режиме энергосбережения)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Требуется установленное и включённое расширение WACK Shell."

msgid "Requires WACK Shell to be enabled."
msgstr "Требуется включить расширение WACK Shell."

msgid "Crossfade Speed"
msgstr "Скорость перехода"

msgid "Slower"
msgstr "Медленнее"

msgid "Faster"
msgstr "Быстрее"

msgid "Clock Animation"
msgstr "Анимация часов"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Применяется к дате и времени при открытии запроса пароля"

msgid "Scale Down"
msgstr "Уменьшение"

msgid "Zoom Up"
msgstr "Увеличение вверх"

msgid "Slide Up"
msgstr "Сдвиг вверх"

msgid "Fade"
msgstr "Затухание"

msgid "Prompt Animation"
msgstr "Анимация окна пароля"

msgid "Applied to the authentication prompt while it appears"
msgstr "Применяется к окну аутентификации при его появлении"

msgid "GNOME Default"
msgstr "Стандартный GNOME"

msgid "Rise"
msgstr "Подъём"

msgid "Zoom"
msgstr "Масштабирование"

msgid "Reset Animations"
msgstr "Сбросить анимации"

msgid "Reset animations"
msgstr "Сбросить анимации"

msgid "Display and Power"
msgstr "Экран и питание"

msgid "Keep Screen On"
msgstr "Не выключать экран"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Предотвращает немедленное отключение экрана при блокировке. Экран погаснет после обычного системного таймаута."

msgid "Only on AC Power"
msgstr "Только при питании от сети"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Оставлять экран включённым только при работе от электросети"

msgid "Escape to Sleep / Suspend"
msgstr "Клавиша Escape для сна"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Нажмите Escape на экране блокировки для отключения экрана (или сна)"

msgid "Extras"
msgstr "Дополнительно"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] Расширение для GDM"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Статус: Включено. Пользовательский интерфейс активен на экране входа GDM."

msgid "Status: Disabled."
msgstr "Статус: Отключено."

msgid "Enabled"
msgstr "Включено"

msgid "Disabled"
msgstr "Отключено"

msgid "Cupertino System Actions"
msgstr "Системные кнопки Cupertino"

msgid "Show Suspend, Restart and Power Off under the login user list, replacing the Quick Settings power menu."
msgstr "Показывает кнопки «Ждущий режим», «Перезагрузка» и «Выключение» под списком пользователей вместо меню быстрых настроек."

msgid "Dim Background Wallpaper"
msgstr "Затемнять фоновый рисунок"

msgid "Apply a subtle 15% darkening overlay to the login wallpaper for enhanced contrast."
msgstr "Накладывает легкое 15% затемнение на обои экрана входа для повышения контрастности."

msgid "GDM Expansion Documentation"
msgstr "Документация расширения GDM"

msgid "Revert GDM login screen layout to GNOME Default. See repository instructions."
msgstr "Возврат экрана входа GDM к стандартному виду GNOME. См. инструкции в репозитории."

msgid "Open repository documentation"
msgstr "Открыть документацию репозитория"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "Расширение не установлено общесистемно в /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "Модули расширения GDM (src/pro) отсутствуют в системе."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "Режим сеанса GDM не включён в общесистемных метаданных."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "Конфигурация dconf для GDM (/etc/dconf/db/gdm.d) отсутствует."

msgid "GDM integration is not configured."
msgstr "Интеграция с GDM не настроена."

msgid "GDM DLC Documentation"
msgstr "Документация модуля GDM"

msgid "Visit the repository to view setup and installation documentation."
msgstr "Перейдите в репозиторий для просмотра инструкций по установке и настройке."

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] Интеграция с WACK Shell"

msgid "Installed"
msgstr "Установлено"

msgid "Not Installed"
msgstr "Не установлено"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Установлено. Включает эффекты плавного перехода и оформление оболочки в стиле Cupertino."

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Не установлено. Установите WACK Shell для включения эффектов перехода."

msgid "WACK Shell Repository"
msgstr "Репозиторий WACK Shell"

msgid "Open the WACK Shell repository for documentation and updates."
msgstr "Открыть репозиторий WACK Shell для ознакомления с документацией и обновлениями."

msgid "Open WACK Shell repository"
msgstr "Открыть репозиторий WACK Shell"

msgid "Visit the repository to view installation instructions and release packages."
msgstr "Перейдите в репозиторий для просмотра инструкций по установке и релизов."

msgid "Clear Visual Cache"
msgstr "Очистить визуальный кэш"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Удаляет временные визуальные данные для обоев и эффектов размытия. Они создадутся заново автоматически."

msgid "Clear"
msgstr "Очистить"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Очищает визуальный кэш, используемый для обоев и эффектов"

msgid "Visual cache cleared successfully!"
msgstr "Визуальный кэш успешно очищен!"

msgid "Failed to clear cache:"
msgstr "Не удалось очистить кэш:"

