msgstr "รูปแบบนาฬิกา"

msgid "Override the system 12/24-hour setting on the lockscreen."
msgstr "แทนที่การตั้งค่า 12/24 ชั่วโมงของระบบบนหน้าจอล็อก"

msgid "System"
msgstr "ระบบ"

msgid "12-hour"
msgstr "12 ชั่วโมง"

msgid "24-hour"
msgstr "24 ชั่วโมง"

msgid "Date Style"
msgstr "รูปแบบวันที่"

msgid "Choose between shortened and full date names."
msgstr "เลือกระหว่างชื่อวันที่แบบย่อหรือแบบเต็ม"

msgid "Short"
msgstr "แบบสั้น"

msgid "Full"
msgstr "แบบเต็ม"

msgid "Wallpaper-Tinted Clock"
msgstr "นาฬิกาย้อมสีตามภาพพื้นหลัง"

msgid "Tint the clock and date with a light shade of the wallpaper colour."
msgstr "ย้อมสีนาฬิกาและวันที่ด้วยเฉดสีอ่อนตามภาพพื้นหลัง"

msgid "Lockscreen Mode"
msgstr "โหมดหน้าจอล็อก"

msgid "Mode"
msgstr "โหมด"

msgid "Legacy"
msgstr "แบบเดิม"

msgid "Cupertino"
msgstr "คูเปอร์ติโน"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "เลย์เอาต์หน้าจอล็อกแบบสมบูรณ์ที่ได้รับแรงบันดาลใจจาก macOS Sonoma (คลิกไอคอนผู้ใช้เพื่อสลับผู้ใช้)"

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "นาฬิกาสไตล์ macOS Sonoma บนเลย์เอาต์ดั้งเดิมของ GNOME"

msgid "Sonoma Status Corner"
msgstr "มุมสถานะ Sonoma"

msgid "Restyle the top-right battery, network and input source icons."
msgstr "ปรับแต่งไอคอนแบตเตอรี่ เครือข่าย และแหล่งป้อนข้อมูลที่มุมขวาบน"

msgid "Always Show User Widget"
msgstr "แสดงวิดเจ็ตผู้ใช้เสมอ"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "ซ่อนการแจ้งเตือนตามค่าเริ่มต้น กด Shift+N เพื่อแสดงการแจ้งเตือน"

msgid "Prompt Vibrancy"
msgstr "เอฟเฟกต์ความลึกของช่องใส่รหัสผ่าน"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "การปรับแต่งสีและความลึกแบบปรับตัวได้สำหรับช่องใส่รหัสผ่าน"

msgid "Lightweight, color-based mode."
msgstr "โหมดน้ำหนักเบาที่ใช้สี"

msgid "Advanced, blur-based mode."
msgstr "โหมดขั้นสูงที่ใช้การเบลอ"

msgid "Tonal"
msgstr "โทนสี"

msgid "Acrylic"
msgstr "อะคริลิก"

msgid "Show message when locked"
msgstr "แสดงข้อความเมื่อล็อกหน้าจอ"

msgid "Set..."
msgstr "ตั้งค่า..."

msgid "Set a message to appear on the lockscreen"
msgstr "ตั้งค่าข้อความที่จะแสดงบนหน้าจอล็อก"

msgid "OK"
msgstr "ตกลง"

msgid "Unlock Crossfade"
msgstr "เอฟเฟกต์การเปลี่ยนผ่านขณะปลดล็อก"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "เปลี่ยนผ่านหน้าจอล็อกกับเดสก์ท็อปอย่างราบรื่นเมื่อปลดล็อก (ปิดใช้งานอัตโนมัติในโหมดประหยัดพลังงาน)"

msgid "Requires WACK Shell to be installed and enabled."
msgstr "ต้องติดตั้งและเปิดใช้งาน WACK Shell"

msgid "Requires WACK Shell to be enabled."
msgstr "ต้องเปิดใช้งาน WACK Shell"

msgid "Crossfade Speed"
msgstr "ความเร็วการเปลี่ยนผ่าน"

msgid "Slower"
msgstr "ช้าลง"

msgid "Faster"
msgstr "เร็วขึ้น"

msgid "Clock Animation"
msgstr "แอนิเมชันนาฬิกา"

msgid "Applied to the date and time while opening the password prompt"
msgstr "นำไปใช้กับวันที่และเวลาขณะเปิดช่องใส่รหัสผ่าน"

msgid "Scale Down"
msgstr "ย่อขนาด"

msgid "Zoom Up"
msgstr "ซูมขึ้น"

msgid "Slide Up"
msgstr "เลื่อนขึ้น"

msgid "Fade"
msgstr "จางหาย"

msgid "Prompt Animation"
msgstr "แอนิเมชันช่องกรอก"

msgid "Applied to the authentication prompt while it appears"
msgstr "นำไปใช้กับหน้าต่างยืนยันตัวตนขณะปรากฏ"

msgid "GNOME Default"
msgstr "ค่าเริ่มต้น GNOME"

msgid "Rise"
msgstr "ยกตัวขึ้น"

msgid "Zoom"
msgstr "ซูม"

msgid "Reset Animations"
msgstr "รีเซ็ตแอนิเมชัน"

msgid "Reset animations"
msgstr "รีเซ็ตแอนิเมชัน"

msgid "Display and Power"
msgstr "จอแสดงผลและพลังงาน"

msgid "Keep Screen On"
msgstr "เปิดหน้าจอไว้ตลอด"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "ป้องกันไม่ให้หน้าจอดับทันทีเมื่อล็อก หน้าจอจะยังคงดับลงหลังจากครบเวลาที่กำหนดไว้ในการตั้งค่าระบบ"

msgid "Only on AC Power"
msgstr "เฉพาะเมื่อเสียบปลั๊กไฟ"

msgid "Only keep the screen on if the system is plugged in"
msgstr "เปิดหน้าจอไว้เฉพาะเมื่ออุปกรณ์เสียบปลั๊กไฟอยู่เท่านั้น"

msgid "Escape to Sleep / Suspend"
msgstr "กดปุ่ม Escape เพื่อพักเครื่อง"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "กด Escape บนหน้าจอล็อกเพื่อดับหน้าจอ (หรือพักเครื่อง)"

msgid "Extras"
msgstr "ส่วนเสริม"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] ส่วนเสริม GDM"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "สถานะ: เปิดใช้งานแล้ว เลย์เอาต์ที่กำหนดเองกำลังทำงานบน GDM"

msgid "Status: Disabled."
msgstr "สถานะ: ปิดใช้งาน"

msgid "Enabled"
msgstr "เปิดใช้งาน"

msgid "Disabled"
msgstr "ปิดใช้งาน"

msgid "Cupertino System Actions"
msgstr "ปุ่มควบคุมระบบ Cupertino"

msgid "Show Suspend, Restart and Power Off under the login user list, replacing the Quick Settings power menu."
msgstr "แสดงพักเครื่อง รีสตาร์ท และปิดเครื่อง ใต้รายชื่อผู้ใช้ แทนที่เมนูเปิด/ปิดในการตั้งค่าด่วน"

msgid "GDM Expansion Documentation"
msgstr "เอกสารส่วนเสริม GDM"

msgid "Revert GDM login screen layout to GNOME Default. See repository instructions."
msgstr "คืนค่าเลย์เอาต์หน้าจอเข้าสู่ระบบ GDM เป็นค่าเริ่มต้นของ GNOME ดูคำแนะนำในที่เก็บข้อมูล"

msgid "Open repository documentation"
msgstr "เปิดคู่มือในที่เก็บข้อมูล"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "ส่วนขยายไม่ได้ติดตั้งทั่วทั้งระบบใน /usr/share"

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "โมดูลส่วนเสริม GDM (src/pro) ขาดหายไปในระบบ"

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "โหมดเซสชัน GDM ไม่ได้เปิดใช้งานในข้อมูลเมตาทั่วทั้งระบบ"

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "ไม่มีไฟล์การกำหนดค่า dconf สำหรับ GDM (/etc/dconf/db/gdm.d)"

msgid "GDM integration is not configured."
msgstr "ไม่ได้กำหนดค่าการทำงานร่วมกับ GDM"

msgid "GDM DLC Documentation"
msgstr "เอกสาร GDM DLC"

msgid "Visit the repository to view setup and installation documentation."
msgstr "ไปที่ที่เก็บข้อมูลเพื่อดูคู่มือการตั้งค่าและการติดตั้ง"

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] การทำงานร่วมกับ WACK Shell"

msgid "Installed"
msgstr "ติดตั้งแล้ว"

msgid "Not Installed"
msgstr "ไม่ได้ติดตั้ง"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "ติดตั้งแล้ว เปิดใช้งานเอฟเฟกต์การเปลี่ยนผ่านและการปรับแต่งเชลล์สไตล์ Cupertino"

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "ยังไม่ได้ติดตั้ง ติดตั้ง WACK Shell เพื่อปลดล็อกเอฟเฟกต์การเปลี่ยนผ่าน"

msgid "WACK Shell Repository"
msgstr "ที่เก็บข้อมูล WACK Shell"

msgid "Open the WACK Shell repository for documentation and updates."
msgstr "เปิดที่เก็บข้อมูล WACK Shell เพื่อดูเอกสารและการอัปเดต"

msgid "Open WACK Shell repository"
msgstr "เปิดที่เก็บข้อมูล WACK Shell"

msgid "Visit the repository to view installation instructions and release packages."
msgstr "ไปที่ที่เก็บข้อมูลเพื่อดูคำแนะนำในการติดตั้งและแพ็กเกจรุ่นที่เผยแพร่"

msgid "Clear Visual Cache"
msgstr "ล้างแคชภาพ"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "ล้างข้อมูลภาพชั่วคราวที่ใช้สำหรับภาพพื้นหลังและเอฟเฟกต์ ระบบจะสร้างข้อมูลขึ้นใหม่โดยอัตโนมัติ"

msgid "Clear"
msgstr "ล้าง"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "ล้างแคชภาพที่ใช้สำหรับภาพพื้นหลังและเอฟเฟกต์"

msgid "Visual cache cleared successfully!"
msgstr "ล้างแคชภาพสำเร็จแล้ว!"

msgid "Failed to clear cache:"
msgstr "ไม่สามารถล้างแคชได้:"

