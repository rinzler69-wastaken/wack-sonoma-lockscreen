msgid "Configuration"
msgstr "Configuração"

msgid "General"
msgstr "Geral"

msgid "Password Field Indicators"
msgstr "Indicadores do campo de senha"

msgid "Show Caps Lock and keyboard layout icons inside the password field."
msgstr "Mostra ícones de Caps Lock e layout do teclado dentro do campo de senha."

msgid "Cursor Blinking"
msgstr "Piscar do cursor"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Ativa ou desativa o cursor piscante no campo de senha."

msgid "Custom Lockscreen Wallpaper"
msgstr "Papel de parede personalizado da tela de bloqueio"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Usar uma imagem personalizada como plano de fundo da tela de bloqueio."

msgid "Wallpaper Image Path"
msgstr "Caminho da imagem do papel de parede"

msgid "No image selected"
msgstr "Nenhuma imagem selecionada"

msgid "Select Lockscreen Wallpaper"
msgstr "Selecionar papel de parede da tela de bloqueio"

msgid "Images and Slideshows"
msgstr "Imagens e apresentações de slides"

msgid "Select Image File"
msgstr "Selecionar arquivo de imagem"

msgid "Select"
msgstr "Selecionar"

msgid "Cancel"
msgstr "Cancelar"

msgid "Per-Monitor Wallpapers"
msgstr "Papéis de parede por monitor"

msgid "Monitors without their own wallpaper use the one above."
msgstr "Monitores sem papel de parede próprio usarão o definido acima."

msgid "Default"
msgstr "Padrão"

msgid "Use the Default Wallpaper"
msgstr "Usar o papel de parede padrão"

msgid "Clock and Date"
msgstr "Relógio e data"

msgid "Clock Weight"
msgstr "Espessura do relógio"

msgid "Font weight of the lockscreen time."
msgstr "Espessura da fonte das horas na tela de bloqueio."

msgid "Restore defaults"
msgstr "Restaurar padrões"

msgid "Light"
msgstr "Fina"

msgid "Regular"
msgstr "Regular"

msgid "Medium"
msgstr "Média"

msgid "Semibold"
msgstr "Seminegrito"

msgid "Bold"
msgstr "Negrito"

msgid "Heavy"
msgstr "Pesada"

msgid "Clock Format"
msgstr "Formato do relógio"

msgid "Override the system 12/24-hour setting on the lockscreen."
msgstr "Substitui a configuração de 12/24 horas do sistema na tela de bloqueio."

msgid "System"
msgstr "Sistema"

msgid "12-hour"
msgstr "12 horas"

msgid "24-hour"
msgstr "24 horas"

msgid "Date Style"
msgstr "Estilo da data"

msgid "Choose between shortened and full date names."
msgstr "Escolha entre nomes de data abreviados ou completos."

msgid "Short"
msgstr "Curto"

msgid "Full"
msgstr "Completo"

msgid "Wallpaper-Tinted Clock"
msgstr "Relógio com tonalidade do papel de parede"

msgid "Tint the clock and date with a light shade of the wallpaper colour."
msgstr "Aplica uma tonalidade suave da cor do papel de parede ao relógio e à data."

msgid "Lockscreen Mode"
msgstr "Modo da tela de bloqueio"

msgid "Mode"
msgstr "Modo"

msgid "Legacy"
msgstr "Clássico"

msgid "Cupertino"
msgstr "Cupertino"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Um layout completo inspirado no macOS Sonoma (clique no ícone de usuário para alternar usuários)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "Relógio no estilo macOS Sonoma sobre o layout e fluxo clássicos do GNOME."

msgid "Sonoma Status Corner"
msgstr "Status superior estilo Sonoma"

msgid "Restyle the top-right battery, network and input source icons."
msgstr "Redesenha os ícones de bateria, rede e método de entrada no canto superior direito."

msgid "Always Show User Widget"
msgstr "Sempre mostrar o widget de usuário"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Oculta as notificações por padrão. Pressione Shift+N para exibi-las."

msgid "Prompt Vibrancy"
msgstr "Vibração do campo de senha"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Melhorias adaptativas de cor e profundidade para o campo de senha."

msgid "Lightweight, color-based mode."
msgstr "Modo leve baseado em cores."

msgid "Advanced, blur-based mode."
msgstr "Modo avançado com efeito de desfoque."

msgid "Tonal"
msgstr "Tonal"

msgid "Acrylic"
msgstr "Acrílico"

msgid "Show message when locked"
msgstr "Exibir mensagem quando bloqueado"

msgid "Set..."
msgstr "Definir..."

msgid "Set a message to appear on the lockscreen"
msgstr "Defina uma mensagem para aparecer na tela de bloqueio"

msgid "OK"
msgstr "OK"

msgid "Unlock Crossfade"
msgstr "Transição suave de desbloqueio"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Transição suave da tela de bloqueio para a área de trabalho ao desbloquear (desativada no modo Economia de Energia)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Requer que a WACK Shell esteja instalada e ativada."

msgid "Requires WACK Shell to be enabled."
msgstr "Requer que a WACK Shell esteja ativada."

msgid "Crossfade Speed"
msgstr "Velocidade da transição"

msgid "Slower"
msgstr "Mais lenta"

msgid "Faster"
msgstr "Mais rápida"

msgid "Clock Animation"
msgstr "Animação do relógio"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Aplicada à data e hora ao abrir a solicitação de senha"

msgid "Scale Down"
msgstr "Reduzir"

msgid "Zoom Up"
msgstr "Aproximar para cima"

msgid "Slide Up"
msgstr "Deslizar para cima"

msgid "Fade"
msgstr "Desvanecer"

msgid "Prompt Animation"
msgstr "Animação de autenticação"

msgid "Applied to the authentication prompt while it appears"
msgstr "Aplicada à solicitação de autenticação ao ser exibida"

msgid "GNOME Default"
msgstr "Padrão do GNOME"

msgid "Rise"
msgstr "Elevação"

msgid "Zoom"
msgstr "Zoom"

msgid "Reset Animations"
msgstr "Redefinir animações"

msgid "Reset animations"
msgstr "Redefinir animações"

msgid "Display and Power"
msgstr "Tela e energia"

msgid "Keep Screen On"
msgstr "Manter a tela ligada"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Evita que a tela desligue imediatamente ao bloquear. A tela ainda desligará após o tempo limite definido nas configurações do sistema."

msgid "Only on AC Power"
msgstr "Apenas conectado à tomada (CA)"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Mantém a tela ligada apenas se o sistema estiver conectado à tomada"

msgid "Escape to Sleep / Suspend"
msgstr "Tecla Esc para suspender"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Pressione Esc na tela de bloqueio para desligar a tela (ou suspender)"

msgid "Extras"
msgstr "Extras"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] Expansão do GDM"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Status: Ativado. O layout personalizado está ativo no GDM."

msgid "Status: Disabled."
msgstr "Status: Desativado."

msgid "Enabled"
msgstr "Ativado"

msgid "Disabled"
msgstr "Desativado"

msgid "Cupertino System Actions"
msgstr "Ações do sistema estilo Cupertino"

msgid "Show Suspend, Restart and Power Off under the login user list, replacing the Quick Settings power menu."
msgstr "Exibe Suspender, Reiniciar e Desligar abaixo da lista de usuários, substituindo o menu de energia das Configurações Rápidas."

msgid "Dim Background Wallpaper"
msgstr "Escurecer papel de parede"

msgid "Apply a subtle 15% darkening overlay to the login wallpaper for enhanced contrast."
msgstr "Aplica uma leve sobreposição escura de 15% ao papel de parede de início de sessão para melhorar o contraste."

msgid "GDM Expansion Documentation"
msgstr "Documentação da expansão do GDM"

msgid "Revert GDM login screen layout to GNOME Default. See repository instructions."
msgstr "Restaura o layout da tela de login do GDM para o padrão do GNOME. Veja as instruções no repositório."

msgid "Open repository documentation"
msgstr "Abrir documentação do repositório"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "A extensão não está instalada no sistema em /usr/share."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "Os módulos de expansão do GDM (src/pro) estão ausentes no sistema."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "O modo de sessão GDM não está ativado nos metadados do sistema."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "A configuração dconf para o GDM (/etc/dconf/db/gdm.d) está ausente."

msgid "GDM integration is not configured."
msgstr "A integração com o GDM não está configurada."

msgid "GDM DLC Documentation"
msgstr "Documentação do DLC do GDM"

msgid "Visit the repository to view setup and installation documentation."
msgstr "Acesse o repositório para ver a documentação de configuração e instalação."

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] Integração com WACK Shell"

msgid "Installed"
msgstr "Instalado"

msgid "Not Installed"
msgstr "Não instalado"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Instalado. Habilita transições suaves e personalizações da shell inspiradas no Cupertino."

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Não instalado. Instale a WACK Shell para desbloquear efeitos de transição."

msgid "WACK Shell Repository"
msgstr "Repositório do WACK Shell"

msgid "Open the WACK Shell repository for documentation and updates."
msgstr "Abre o repositório da WACK Shell para documentação e atualizações."

msgid "Open WACK Shell repository"
msgstr "Abrir repositório da WACK Shell"

msgid "Visit the repository to view installation instructions and release packages."
msgstr "Acesse o repositório para ver instruções de instalação e pacotes de versão."

msgid "Clear Visual Cache"
msgstr "Limpar cache visual"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Limpa os dados visuais temporários usados para papéis de parede e efeitos. Eles serão gerados novamente de forma automática."

msgid "Clear"
msgstr "Limpar"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Limpa o cache visual usado para papéis de parede e efeitos"

msgid "Visual cache cleared successfully!"
msgstr "Cache visual limpo com sucesso!"

msgid "Failed to clear cache:"
msgstr "Falha ao limpar o cache:"

