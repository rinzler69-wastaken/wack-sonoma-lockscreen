msgid "Configuration"
msgstr "Konfiguration"

msgid "General"
msgstr "Allgemein"

msgid "Password Field Indicators"
msgstr "Symbole im Passwortfeld"

msgid "Show Caps Lock and keyboard layout icons inside the password field."
msgstr "Zeigt Feststelltasten- und Tastaturlayout-Symbole im Passwortfeld an."

msgid "Cursor Blinking"
msgstr "Blinkender Cursor"

msgid "Enable or disable text cursor blinking in the password field."
msgstr "Aktivieren oder Deaktivieren des blinkenden Cursors im Passwortfeld."

msgid "Custom Lockscreen Wallpaper"
msgstr "Eigener Sperrbildschirm-Hintergrund"

msgid "Use a custom image overlay for the lockscreen background."
msgstr "Verwendet ein eigenes Bild für den Sperrbildschirm-Hintergrund."

msgid "Wallpaper Image Path"
msgstr "Pfad zum Hintergrundbild"

msgid "No image selected"
msgstr "Kein Bild ausgewählt"

msgid "Select Lockscreen Wallpaper"
msgstr "Sperrbildschirm-Hintergrund auswählen"

msgid "Images and Slideshows"
msgstr "Bilder und Diashows"

msgid "Select Image File"
msgstr "Bilddatei auswählen"

msgid "Select"
msgstr "Auswählen"

msgid "Cancel"
msgstr "Abbrechen"

msgid "Per-Monitor Wallpapers"
msgstr "Hintergründe pro Bildschirm"

msgid "Monitors without their own wallpaper use the one above."
msgstr "Bildschirme ohne eigenen Hintergrund verwenden den oben eingestellten."

msgid "Default"
msgstr "Standard"

msgid "Use the Default Wallpaper"
msgstr "Standard-Hintergrundbild verwenden"

msgid "Clock and Date"
msgstr "Uhrzeit und Datum"

msgid "Clock Weight"
msgstr "Schriftstärke der Uhr"

msgid "Font weight of the lockscreen time."
msgstr "Schriftstärke der Uhrzeit auf dem Sperrbildschirm."

msgid "Restore defaults"
msgstr "Standardwerte wiederherstellen"

msgid "Light"
msgstr "Leicht"

msgid "Regular"
msgstr "Normal"

msgid "Medium"
msgstr "Mittel"

msgid "Semibold"
msgstr "Halbfett"

msgid "Bold"
msgstr "Fett"

msgid "Heavy"
msgstr "Schwer"

msgid "Clock Format"
msgstr "Uhrzeitformat"

msgid "Override the system 12/24-hour setting on the lockscreen."
msgstr "Überschreibt das 12-/24-Stunden-Format des Systems auf dem Sperrbildschirm."

msgid "System"
msgstr "System"

msgid "12-hour"
msgstr "12-Stunden"

msgid "24-hour"
msgstr "24-Stunden"

msgid "Date Style"
msgstr "Datumsformat"

msgid "Choose between shortened and full date names."
msgstr "Wählen Sie zwischen verkürzten und vollständigen Datumsangaben."

msgid "Short"
msgstr "Kurz"

msgid "Full"
msgstr "Vollständig"

msgid "Wallpaper-Tinted Clock"
msgstr "Hintergrund-getönte Uhr"

msgid "Tint the clock and date with a light shade of the wallpaper colour."
msgstr "Tönt Uhrzeit und Datum mit einem leichten Farbton des Hintergrundbildes."

msgid "Lockscreen Mode"
msgstr "Sperrbildschirm-Modus"

msgid "Mode"
msgstr "Modus"

msgid "Legacy"
msgstr "Klassisch"

msgid "Cupertino"
msgstr "Cupertino"

msgid "A complete macOS Sonoma-inspired lockscreen layout (Click user-icon to switch users)."
msgstr "Ein vollständiges, von macOS Sonoma inspiriertes Layout (Klicken Sie auf das Benutzersymbol, um den Benutzer zu wechseln)."

msgid "macOS Sonoma-style clock over the classic, GNOME-compliant layout and flow."
msgstr "Uhr im Stil von macOS Sonoma über dem klassischen, GNOME-konformen Layout."

msgid "Sonoma Status Corner"
msgstr "Sonoma-Statusbereich"

msgid "Restyle the top-right battery, network and input source icons."
msgstr "Passt das Design der Akku-, Netzwerk- und Eingabequellen-Symbole oben rechts an."

msgid "Always Show User Widget"
msgstr "Benutzer-Widget immer anzeigen"

msgid "Hides notifications by default. Press Shift+N to show notifications."
msgstr "Blendet Benachrichtigungen standardmäßig aus. Drücken Sie Umschalt+N, um sie anzuzeigen."

msgid "Prompt Vibrancy"
msgstr "Passwortfeld-Vibranz"

msgid "Adaptive color and depth enhancements for the password field."
msgstr "Adaptive Farb- und Tiefeneffekte für das Passwortfeld."

msgid "Lightweight, color-based mode."
msgstr "Leichtgewichtiger, farbbasierter Modus."

msgid "Advanced, blur-based mode."
msgstr "Fortgeschrittener Modus mit Unschärfe."

msgid "Tonal"
msgstr "Tonal"

msgid "Acrylic"
msgstr "Acryl"

msgid "Show message when locked"
msgstr "Nachricht im gesperrten Zustand anzeigen"

msgid "Set..."
msgstr "Einstellen..."

msgid "Set a message to appear on the lockscreen"
msgstr "Geben Sie eine Nachricht für den Sperrbildschirm ein"

msgid "OK"
msgstr "OK"

msgid "Unlock Crossfade"
msgstr "Überblendung beim Entsperren"

msgid "Crossfade the lockscreen with desktop when unlocking (automatically disabled in Power Saver mode)."
msgstr "Blendet beim Entsperren weich zum Desktop über (im Energiesparmodus automatisch deaktiviert)."

msgid "Requires WACK Shell to be installed and enabled."
msgstr "Erfordert, dass WACK Shell installiert und aktiviert ist."

msgid "Requires WACK Shell to be enabled."
msgstr "Erfordert, dass WACK Shell aktiviert ist."

msgid "Crossfade Speed"
msgstr "Überblendungsgeschwindigkeit"

msgid "Slower"
msgstr "Langsamer"

msgid "Faster"
msgstr "Schneller"

msgid "Clock Animation"
msgstr "Uhr-Animation"

msgid "Applied to the date and time while opening the password prompt"
msgstr "Wird beim Öffnen des Passwortfelds auf Datum und Uhrzeit angewendet"

msgid "Scale Down"
msgstr "Verkleinern"

msgid "Zoom Up"
msgstr "Heranzoomen nach oben"

msgid "Slide Up"
msgstr "Nach oben schieben"

msgid "Fade"
msgstr "Ausblenden"

msgid "Prompt Animation"
msgstr "Passwortabfrage-Animation"

msgid "Applied to the authentication prompt while it appears"
msgstr "Wird beim Erscheinen der Authentifizierungsabfrage angewendet"

msgid "GNOME Default"
msgstr "GNOME-Standard"

msgid "Rise"
msgstr "Aufsteigen"

msgid "Zoom"
msgstr "Zoom"

msgid "Reset Animations"
msgstr "Animationen zurücksetzen"

msgid "Reset animations"
msgstr "Animationen zurücksetzen"

msgid "Display and Power"
msgstr "Anzeige und Energie"

msgid "Keep Screen On"
msgstr "Bildschirm eingeschaltet lassen"

msgid "Prevent the screen from immediately turning off when locked. The screen will still turn off after the normal timeout duration set in system settings."
msgstr "Verhindert das sofortige Ausschalten des Bildschirms beim Sperren. Er schaltet sich nach der normalen System-Zeitspanne ab."

msgid "Only on AC Power"
msgstr "Nur bei Netzbetrieb"

msgid "Only keep the screen on if the system is plugged in"
msgstr "Hält den Bildschirm nur eingeschaltet, wenn das Gerät an das Stromnetz angeschlossen ist"

msgid "Escape to Sleep / Suspend"
msgstr "Escape für Bereitschaft / Ruhezustand"

msgid "Press Escape on the lock screen to sleep display (or suspend)"
msgstr "Drücken Sie Escape auf dem Sperrbildschirm, um das Display auszuschalten (oder in Bereitschaft zu wechseln)"

msgid "Extras"
msgstr "Extras"

msgid "[PRO] GDM Expansion"
msgstr "[PRO] GDM-Erweiterung"

msgid "Status: Enabled. Custom layout is active on GDM."
msgstr "Status: Aktiviert. Das angepasste Layout ist auf GDM aktiv."

msgid "Status: Disabled."
msgstr "Status: Deaktiviert."

msgid "Enabled"
msgstr "Aktiviert"

msgid "Disabled"
msgstr "Deaktiviert"

msgid "Cupertino System Actions"
msgstr "Cupertino-Systemaktionen"

msgid "Show Suspend, Restart and Power Off under the login user list, replacing the Quick Settings power menu."
msgstr "Zeigt Bereitschaft, Neustart und Ausschalten unter der Benutzerliste an (ersetzt das Schnellmenü-Energiemenü)."

msgid "Dim Background Wallpaper"
msgstr "Hintergrundbild abdunkeln"

msgid "Apply a subtle 15% darkening overlay to the login wallpaper for enhanced contrast."
msgstr "Wendet eine dezente 15%ige Abdunklung auf das Anmelde-Hintergrundbild an, um den Kontrast zu verbessern."

msgid "GDM Expansion Documentation"
msgstr "Dokumentation zur GDM-Erweiterung"

msgid "Revert GDM login screen layout to GNOME Default. See repository instructions."
msgstr "Setzt das GDM-Anmeldefenster auf den GNOME-Standard zurück. Siehe Anweisungen im Repository."

msgid "Open repository documentation"
msgstr "Repository-Dokumentation öffnen"

msgid "Extension is not installed system-wide in /usr/share."
msgstr "Die Erweiterung ist nicht systemweit in /usr/share installiert."

msgid "GDM expansion modules (src/pro) are missing system-wide."
msgstr "GDM-Erweiterungsmodule (src/pro) fehlen systemweit."

msgid "GDM session mode is not enabled in system-wide metadata."
msgstr "Der GDM-Sitzungsmodus ist in den systemweiten Metadaten nicht aktiviert."

msgid "GDM dconf override configuration (/etc/dconf/db/gdm.d) is missing."
msgstr "Die dconf-Konfiguration für GDM (/etc/dconf/db/gdm.d) fehlt."

msgid "GDM integration is not configured."
msgstr "GDM-Integration ist nicht konfiguriert."

msgid "GDM DLC Documentation"
msgstr "Dokumentation zum GDM-DLC"

msgid "Visit the repository to view setup and installation documentation."
msgstr "Besuchen Sie das Repository für Einrichtungs- und Installationsanweisungen."

msgid "[BETA] WACK Shell Integration"
msgstr "[BETA] WACK Shell-Integration"

msgid "Installed"
msgstr "Installiert"

msgid "Not Installed"
msgstr "Nicht installiert"

msgid "Installed. Enables crossfade transitions and Cupertino-inspired shell customisations."
msgstr "Installiert. Ermöglicht sanfte Überblendungen und von Cupertino inspirierte Shell-Anpassungen."

msgid "Not installed. Install WACK Shell to unlock transition effects."
msgstr "Nicht installiert. Installieren Sie WACK Shell, um Übergangseffekte freizuschalten."

msgid "WACK Shell Repository"
msgstr "WACK Shell-Repository"

msgid "Open the WACK Shell repository for documentation and updates."
msgstr "Öffnen Sie das WACK Shell-Repository für Dokumentation und Aktualisierungen."

msgid "Open WACK Shell repository"
msgstr "WACK Shell-Repository öffnen"

msgid "Visit the repository to view installation instructions and release packages."
msgstr "Besuchen Sie das Repository für Installationsanweisungen und Veröffentlichungspakete."

msgid "Clear Visual Cache"
msgstr "Visuellen Cache leeren"

msgid "Clears temporary visual data used for wallpapers and vibrancy effects. It will be regenerated automatically."
msgstr "Löscht temporäre visuelle Daten für Hintergrundbilder und Effekte. Sie werden automatisch neu generiert."

msgid "Clear"
msgstr "Leeren"

msgid "Clears the visual cache used for wallpapers and vibrancy effects"
msgstr "Leert den visuellen Cache für Hintergrundbilder und Effekte"

msgid "Visual cache cleared successfully!"
msgstr "Visueller Cache erfolgreich geleert!"

msgid "Failed to clear cache:"
msgstr "Fehler beim Leeren des Caches:"

